# Python 가상환경 및 캐시 제외함
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# 환경변수 및 인증정보 제외함
.env
.env.*
.streamlit/secrets.toml
**/secrets.toml
*api_key*
*apikey*
*credentials*
*.pem
*.key

# 재배포 권한 확인 전 PDF 추적 제외함
*.[pP][dD][fF]

# 임시 파일 및 로그 제외함
*.tmp
*.temp
*.log
*.bak
*.swp
~$*
logs/
.cache/

# IDE 및 운영체제 임시 파일 제외함
.idea/
.vscode/
.DS_Store
Thumbs.db

# outputs에는 PNG와 하위 폴더만 추적 허용함
outputs/**
!outputs/**/
!outputs/**/*.[pP][nN][gG]
